# radwan-cafe-backend environment (copy to .env; .env is git-ignored).
#
# Database is SQLite everywhere — there is intentionally NO DATABASE_URL.

# --- Core ---------------------------------------------------------------
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=


# Dev: 1/True. Prod: 0/False.
DEBUG=False

# Comma-separated. Documented prod value:

# --- Production (PythonAnywhere) ----------------------------------------
# Needed for the Django admin & browsable docs over HTTPS. The token-auth
# API itself is CSRF-exempt.
CSRF_TRUSTED_ORIGINS=https://radwancafe.pythonanywhere.com

# Absolute path to the SQLite file. If empty, defaults to <project>/db.sqlite3.
# On PythonAnywhere, point this outside the repo, e.g.:
#   SQLITE_PATH=/home/radwancafe/radwan-cafe-backend/db.sqlite3
SQLITE_PATH=

# --- Optional -----------------------------------------------------------
# CORS is not needed for the native Flutter client; set this only for a
# future web build. Comma-separated origins.
CORS_ALLOWED_ORIGINS=

# Set to 0 to disable HTTPS redirect (e.g. behind a proxy that already does it).
# SECURE_SSL_REDIRECT=1
